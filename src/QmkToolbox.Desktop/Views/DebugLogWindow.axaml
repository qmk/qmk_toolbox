<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QmkToolbox.Desktop.ViewModels"
        xmlns:controls="using:QmkToolbox.Desktop.Views.Controls"
        x:Class="QmkToolbox.Desktop.Views.DebugLogWindow"
        x:DataType="vm:DebugLogViewModel"
        x:CompileBindings="True"
        Title="Debug Log"
        Width="900" Height="500"
        MinWidth="500" MinHeight="300">

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="8,4" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0"
                       Text="USB event and flash orchestrator diagnostics"
                       VerticalAlignment="Center"
                       Opacity="0.5" />
            <Button Grid.Column="1" Margin="0,0,4,0" Content="Copy All" Command="{Binding CopyAllCommand}" />
            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearCommand}" />
        </Grid>
        <controls:LogPanel LogEntries="{Binding LogEntries}"
                           CopyCommand="{Binding CopyAllCommand}"
                           ClearCommand="{Binding ClearCommand}" />
    </DockPanel>
</Window>
