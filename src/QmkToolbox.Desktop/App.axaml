<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="QmkToolbox.Desktop.App"
             Name="QMK Toolbox">
    <Application.Styles>
        <semi:SemiTheme Locale="en-US" />
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="avares://qmk_toolbox/Assets/Fonts#Atkinson Hyperlegible" />
        </Style>
        <Style Selector=":is(TemplatedControl)">
            <Setter Property="FontFamily" Value="avares://qmk_toolbox/Assets/Fonts#Atkinson Hyperlegible" />
        </Style>
        <Style Selector="AccessText">
            <Setter Property="ShowAccessKey" Value="True" />
        </Style>
    </Application.Styles>

    <!-- Application-level NativeMenu for macOS: sets the bold "QMK Toolbox" app menu.
         Must be declared here (loaded during Initialize()) so the macOS backend picks it
         up when it creates the NSMenuBar — the programmatic menu in App.axaml.cs adds
         Quit and wires commands, but this AXAML entry is what keeps About clickable. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About QMK Toolbox" Click="AppAbout_OnClick" />
        </NativeMenu>
    </NativeMenu.Menu>
</Application>
