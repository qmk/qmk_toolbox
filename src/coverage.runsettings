<?xml version="1.0" encoding="utf-8"?>
<!-- Settings for the coverlet "XPlat Code Coverage" collector (dotnet test).
     Excluded so the coverage number reflects code the test suite can actually reach:
     Views and App/Program/DesktopWindowService are Avalonia glue only exercisable by
     a running app, and generated code (CompiledAvaloniaXaml, MVVM source generators)
     is noise. Everything else in Desktop counts — platform adapters at 0% are real,
     currently untested code, not exclusions. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[qmk_toolbox]QmkToolbox.Desktop.Views.*,[qmk_toolbox]CompiledAvaloniaXaml.*,[qmk_toolbox]QmkToolbox.Desktop.App,[qmk_toolbox]QmkToolbox.Desktop.Program,[qmk_toolbox]QmkToolbox.Desktop.Services.DesktopWindowService</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,ObsoleteAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
